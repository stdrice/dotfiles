// -*- mode: jsonc -*-
{
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "height": 34, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 4, // Gaps between modules (4px)
    "reload_style_on_change": true,

    "modules-left": [
        // "custom/menu",
        "sway/workspaces",
        "sway/scratchpad",
        "sway/mode",
        "cpu",
        "group/resources",
        "tray",
        "privacy"
    ],
    "modules-center": [
        "sway/window"
    ],
    "modules-right": [
        // "custom/media",
        "network",
        "wireplumber",
	    "backlight",
        "battery",
        "group/clock"
    ],

    // Modules configuration
    "sway/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "format": "{name}"
     },

    "sway/mode": {
        "format": "{}",
        "tooltip": false
    },

    "sway/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": ["", "[-]:"],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },

    "sway/window": {
        "format": "{title}",
        "icon": false,
        "icon-size": 14,
        "max-length": 48,
        "all-outputs": true,
        "tooltip": true
    },

    "tray": {
        "icon-size": 14,
        "spacing": 5
    },

    "group/clock": {
        "orientation": "horizontal",
        "modules": [ "clock#time", "clock#date" ],
        "drawer": {
            "transition-left-to-right": false
        }
    },
    "clock#time": {
        "interval": 60,
        "format": "{:%H:%M <span color='#aaaaaa'>(%Z)</span>}", // 24h
        // "format": "{:%I:%M %p <span color='#aaaaaa'>(%Z)</span>}" // 12h
        "tooltip-format": "{tz_list}",
        "timezones" : [
            "",
            "UTC",
            "Asia/Tokyo",
            "Asia/Singapore",
            "Asia/Bangkok",
            "Asia/Shanghai",
            "America/New_York",
            "America/Los_Angeles"
        ],
        "actions": {
            "on-scroll-up": "tz_up",
            "on-scroll-down": "tz_down"
        }
    },
    "clock#date": {
        // "timezone": "America/New_York",
        "format": "{:%a %d %b}", // 24-hour
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt>{calendar}</tt>",
        "calendar": {
            "mode"          : "year",
            "mode-mon-col"  : 2,
            "weeks-pos"     : "right",
            "on-scroll"     : 1,
            "format": {
                "months":     "<span color='#633aff'><b>{}</b></span>",
                "weeks":      "<span color='#61E2FF'><b>W{}</b></span>",
                "today":      "<span color='#f53fa1'><b><u>{}</u></b></span>"
            }
        }
    },

    "backlight": {
        // "device": "acpi_video1",
        "format": "<b>{icon}</b> {percent}",
        "format-icons": ["/--", "//-", "///"],
      	"tooltip-format": "Brightness: {percent}%\nClick to toggle Night Light",
        "on-click": "~/.local/bin/night-light"
    },

    "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "<b>{icon}</b> {capacity}",
        "format-charging": "<b>CHG</b> {capacity}",
        "format-plugged": "<b>CHG</b> {capacity}",
        "format-icons": ["#--", "##-", "###"],
	    "tooltip-format": "Battery: {capacity}%\n{power}W\n{timeTo}\nHealth: {health}%",
        "interval": 60,
        // "on-click": "~/.local/bin/power"
    },

    "wireplumber": {
        // "scroll-step": 1, // %, can be a float
        "format": "<b>{icon}</b> {node_name}/<span color='#aaaaaa'>{volume}</span>",
        "format-muted": " X ",
        "format-source": "MIC {volume}",
        "format-source-muted": "MIC-",
        "format-icons": ["+--", "++-", "+++"],
        "tooltip": true,
      	"tooltip-format": "Volume: {volume}%\n{node_name}",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol"
    },

    "custom/media": {
	    "format": "{}",
	    "return-type": "json",
        "max-length": 36,
        "exec": "playerctl -a metadata --format '{\"text\": \"{{markup_escape(title)}}\", \"tooltip\": \"{{playerName}} : {{markup_escape(title)}}\", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' -F",
        "on-click": "playerctl play-pause"
    },

    "cpu": {
        "interval": 30,
        "format": "CPU <b>{usage}</b>%"
    },

    "group/resources": {
        "orientation": "horizontal",
        "modules": [ "memory", "disk#root" ],
        "drawer": {}
    },
    "memory": {
        "interval": 45,
        "format": "MEM <b>{used:0.1f}</b>/<span color='#aaaaaa'>{total:0.1f}</span>"
    },
    "disk#root": {
        "interval": 360,
        "format": "HDD <b>{used}</b>/<span color='#aaaaaa'>{total}</span>",
        "path": "/"
    },

    "privacy": {
	    "icon-spacing": 5,
	    "icon-size": 12,
	    "transition-duration": 0,
	    "modules": [
		    {
			    "type": "screenshare",
			    "tooltip": true,
			    "tooltip-icon-size": 24
		    },
		    {
			    "type": "audio-in",
			    "tooltip": true,
			    "tooltip-icon-size": 24
		    }
	    ],
	    "ignore-monitor": true
    },

    "network": {
        "format": "{ifname}",
        "format-wifi": "<b>WiFi</b> {essid} <span color='#aaaaaa'>{signalStrength}</span>",
        "format-ethernet": "<b>ETH</b> {ipaddr}/<span color='#aaaaaa'>{cidr}</span>",
        "format-disconnected": "DC'D",
        "tooltip-format": "{ifname} via {gwaddr}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "networkmanager_dmenu"
    },

    "custom/menu": {
        "format": "#",
        "on-click": "pgrep -x rofi && pkill -x rofi || rofi -show drun",
        "on-click-right": "~/.local/bin/menu",
	    "tooltip": false
    }
}
