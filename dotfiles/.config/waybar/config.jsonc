// -*- mode: jsonc -*-
{
    "layer": "bottom", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "height": 30, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 4, // Gaps between modules (4px)
    "reload_style_on_change": true,

    "modules-left": [
        "niri/workspaces",
        "group/cpu",
        "group/resources",
        "privacy"
    ],
    "modules-center": [
        // "niri/window"
        "clock#date",
        "clock#time"
    ],
    "modules-right": [
        // "custom/media",
        // "network",
        "wireplumber",
	    "backlight",
        "battery",
        "tray"
    ],

    // Modules configuration
    "niri/workspaces": {
     },

    "niri/window": {
        "format": "{title}",
        "icon": false,
        "icon-size": 14,
        "max-length": 48,
        "all-outputs": true,
        "tooltip": true
    },

    "tray": {
        "icon-size": 14,
        "spacing": 5
    },

    "group/clock": {
        "orientation": "horizontal",
        "modules": [ "clock#time", "clock#date" ],
        "drawer": {
            "transition-left-to-right": false
        }
    },
    "clock#time": {
        "interval": 60,
        "format": "{:%H:%M}", // 24h
        // "format": "{:%I:%M %p}" // 12h
        "tooltip-format": "{tz_list}",
        "timezone-tooltip-format": "{:%H:%M %Z}",
        "timezones" : [
            "",
            "UTC",
            "Asia/Tokyo",
            "Asia/Singapore",
            "Asia/Bangkok",
            "Asia/Shanghai",
            "America/New_York",
            "America/Los_Angeles"
        ]
    },
    "clock#date": {
        // "timezone": "America/New_York",
        "format": "{:%a %d %b}", // 24-hour
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt>{calendar}</tt>",
        "calendar": {
            "mode"          : "year",
            "mode-mon-col"  : 3,
            "weeks-pos"     : "right",
            "on-scroll"     : 1,
            "format": {
                "months":     "<span color='#633aff'><b>{}</b></span>",
                "weeks":      "<span color='#61E2FF'><b>{}</b></span>",
                "today":      "<span color='#f53fa1'><b><u>{}</u></b></span>"
            }
        }
    },

    "backlight": {
        // "device": "acpi_video1",
        "format": "{icon} {percent}",
        "format-icons": [""],
      	"tooltip-format": "Brightness: {percent}%\nClick to toggle Night Light",
        "on-click": "~/.local/bin/night-light"
    },

    "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}",
        "format-charging": " {capacity}",
        "format-plugged": " {capacity}",
        "format-icons": ["", "", "", "", ""],
	    "tooltip-format": "Battery: {capacity}%\n{power}W\n{timeTo}\nHealth: {health}%",
        "interval": 60,
        // "on-click": "~/.local/bin/power"
    },

    "wireplumber": {
        // "scroll-step": 1, // %, can be a float
        "format": "{icon} {volume}",
        "format-muted": "  ",
        "format-source": " {volume}",
        "format-source-muted": "  ",
        "format-icons": ["", "", ""],
        "tooltip": true,
      	"tooltip-format": "Volume: {volume}%\n{node_name}",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol"
    },

    "custom/media": {
	    "format": "{}",
	    "return-type": "json",
        "max-length": 36,
        "exec": "playerctl -a metadata --format '{\"text\": \"{{markup_escape(title)}}\", \"tooltip\": \"{{playerName}} : {{markup_escape(title)}}\", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' -F",
        "on-click": "playerctl play-pause"
    },

    "group/cpu": {
        "orientation": "horizontal",
        "modules": [ "cpu", "temperature" ],
        "drawer": {}
    },

    "cpu": {
        "interval": 30,
        "format": " {usage}"
    },

     "temperature": {
	// "thermal-zone": 2,
	// "hwmon-path": ["/sys/class/hwmon/hwmon2/temp1_input", "/sys/class/thermal/thermal_zone0/temp"],
    "interval": 30,
	"format": " {temperatureC}°C"
    },

    "group/resources": {
        "orientation": "horizontal",
        "modules": [ "memory", "disk#root" ],
        "drawer": {}
    },
    "memory": {
        "interval": 45,
        "format": " {used:0.1f}/<span color='#aaaaaa'>{total:0.1f}</span>"
    },
    "disk#root": {
        "interval": 360,
        "format": " {used}/<span color='#aaaaaa'>{total}</span>",
        "path": "/"
    },

    "privacy": {
	    "icon-spacing": 5,
	    "icon-size": 12,
	    "transition-duration": 0,
	    "modules": [
		    {
			    "type": "screenshare",
			    "tooltip": true,
			    "tooltip-icon-size": 24
		    },
		    {
			    "type": "audio-in",
			    "tooltip": true,
			    "tooltip-icon-size": 24
		    }
	    ],
	    "ignore-monitor": true
    },

    "network": {
        "format": "{ifname}",
        "format-wifi": " {essid} <span color='#aaaaaa'>{signalStrength}</span>",
        "format-ethernet": " {ipaddr}/<span color='#aaaaaa'>{cidr}</span>",
        "format-disconnected": "DC'D",
        "tooltip-format": "{ifname} via {gwaddr}",
        "tooltip-format-wifi": "WiFi: {essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "networkmanager_dmenu"
    }
}
