include=~/.config/mako/colors

sort=-time
layer=overlay
width=380
height=130
anchor=top-right
text-alignment=left

border-size=0
border-radius=0
margin=18,0
padding=20,20
max-icon-size=38
default-timeout=5000
ignore-timeout=1
font=sans 10
format=<b>%s</b>\n%b

on-button-left=invoke-default-action
on-button-middle=exec makoctl menu -n $id rofi -dmenu -p 'Select action: '
on-button-right=dismiss

[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb]
invisible=0
