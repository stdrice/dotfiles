# @TODO: finish replacing the colors here


# Menu
menu.border.color: #FFFFFF

menu.title.bg: Solid Flat
menu.title.bg.color: #2C2C2E
menu.title.bg.shadow: 0
menu.title.text.color: #EBEBF5
menu.title.text.justify: Center

menu.items.bg: Solid Flat
menu.items.bg.color: #2C2C2E
menu.items.text.color: #EBEBF5
menu.items.disabled.text.color: #bbbbc3

menu.items.active.bg: Solid Flat
menu.items.active.bg.color: #3c3c3e
menu.items.active.text.color: #EBEBF5

menu.separator.color: #bbbbc3
menu.separator.width: 1
menu.separator.padding.width: 2
menu.separator.padding.height: 4

# Window focused
window.active.title.separator.color: #2C2C2E

# Active window
window.active.border.color: #1c1c1e


window.active.title.bg: flat solid
window.active.title.bg.color: #2C2C2E
window.active.title.separator.color: #2C2C2E
window.active.text.justify: center

window.active.label.bg: parentrelative
window.active.label.text.color: #EBEBF5

window.active.handle.bg: flat solid
window.active.handle.bg.color: #2C2C2E

window.active.grip.bg: flat solid
window.active.grip.bg.color: #2C2C2E

window.active.button.unpressed.bg: flat solid
window.active.button.unpressed.bg.color: #2C2C2E
window.active.button.unpressed.image.color: #EBEBF5

window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #3c3c3e
window.active.button.pressed.image.color: #ffffff

window.active.button.disabled.bg: flat solid
window.active.button.disabled.bg.color: #2C2C2E
window.active.button.disabled.image.color: #bbbbc3

window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #2C2C2E
window.active.button.hover.image.color: #3c3c3e

#window.active.button.toggled.bg: #3c3c3e
#window.active.button.toggled.image.color: #ffffff

# Inactive window
window.inactive.border.color: #2C2C2E

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #2C2C2E
window.inactive.title.separator.color: #2C2C2E
window.inactive.text.justify: center

window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #bbbbc3

window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #2C2C2E

window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #2C2C2E

window.inactive.button.unpressed.bg: flat solid
window.inactive.button.unpressed.bg.color: #2C2C2E
window.inactive.button.unpressed.image.color: #bbbbc3

window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #3c3c3e
window.inactive.button.pressed.image.color: #ffffff

window.inactive.button.disabled.bg: flat solid
window.inactive.button.disabled.bg.color: #bbbbc3
window.inactive.button.disabled.image.color: #2C2C2E

window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #2C2C2E
window.inactive.button.hover.image.color: #3c3c3e


# OSD
osd.border.width: 1
osd.border.color: #3c3c3e

osd.bg: flat solid
osd.bg.color: #2C2C2E
osd.label.bg: flat solid
osd.label.bg.color: #2C2C2E
osd.label.text.color: #EBEBF5

# OSD
osd.bg: Solid Flat
osd.bg.color: #2C2C2E
osd.bg.shadow: 0

osd.border.width: 2
osd.hilight.bg: Solid Flat
osd.hilight.bg.color: #3c3c3e
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #1C1C1E

osd.button.unpressed.bg: flat border
osd.button.unpressed.bg.color: #3c3c3e
#osd.button.unpressed.*.border.color: #ebebf5

osd.button.pressed.bg: flat border
osd.button.pressed.bg.color: #3c3c3e
#osd.button.pressed.*.border.color: #ffffff

osd.button.focused.bg: flat solid border
osd.button.focused.bg.color: #FFFFFF
#osd.button.focused.*.border.color: #1C1C1E

osd.button.focused.box.color: #3c3c3e


# Fonts
window.active.label.text.font:shadow=n
window.inactive.label.text.font:shadow=n
menu.items.font:shadow=n
menu.title.text.font:shadow=n


# Everything else
border.width: 3
padding.width: 8
padding.height: 3
window.handle.width: 0
window.client.padding.width: 0
window.label.text.justify: center
#menu.overlap: 0
