@theme "/dev/null"

* {
  background-color: @background;
  text-color: @foreground;
  background: #242424;
  foreground: #E2E2E2;
}

window {
  location: center;
  width: 280;
  spacing: 0;
  background-color: @background;
  text-color: @foreground;
  border-radius: 0px;
  padding: 8px;
  spacing: 5px;
}

entry {
  placeholder: "Search";
  placeholder-color: #60606050;
  padding: 5px;
  expand: false;
}

element {
  text-color: #60606050;
  padding: 7px;
}

element selected {
  text-color: @foreground;
}

element-text, element-icon {
  background-color: inherit;
  text-color: inherit;
}

listview {
  lines: 12;
  dynamic: true;
  fixed-height: false;
}

prompt {
  enabled: false;
}

listview, element, element selected, element-text, element-icon {
  cursor: pointer;
}
