# - --------- -
# - Autostart -
# - --------- -

# Run with every reload
exec_always {
    xrdb ~/.Xdefaults # Xwayland app settings
    ~/.local/bin/import-gsettings # Import Gsettings
}

# Run once on login
exec {
    # ~/.local/bin/start-pipewire # Start pipewire

    # Sway does not set DISPLAY/WAYLAND_DISPLAY in the systemd user environment
    # See FS#63021
    # Adapted from xorg's 50-systemd-user.sh, which achieves a similar goal.
    # - systemd
    # systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_CURRENT_DESKTOP=sway
    # - non-systemd
    hash dbus-update-activation-environment 2>/dev/null && \
         dbus-update-activation-environment --systemd --all \
         dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_CURRENT_DESKTOP=sway

    dbus-update-activation-environment --systemd DBUS_SESSION_BUS_ADDRESS DISPLAY XAUTHORITY # Prevents GTK apps from hanging for 15-20 sec before launching
    dbus-update-activation-environment XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE
    dex --autostart # XDG autostart
    /usr/lib/xdg-desktop-portal -r # Desktop portal
    /usr/lib/xdg-desktop-portal-wlr -r # Wayland Desktop portal
    waybar # Statusbar
    mako # Notification
    /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 # Polkit
    nm-applet # NetworkManager Applet
    blueman-applet # Bluetooth Applet
    mpd # Music Player Daemon
    # fcitx5 # Input Method
    wl-paste --type text --watch cliphist store # Clipboard manager
    wl-paste --type image --watch cliphist store # Clipboard manager but use for image
}

