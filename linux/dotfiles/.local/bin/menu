#!/usr/bin/env bash

# options
apps="Apps"
powermenu="Power"
nightlight="Night Light"
powerprofile="Power Profile"
theme="Theme"

rofi_cmd() {
    rofi -dmenu
}

run_rofi() {
    echo -e "$apps\n$powermenu\n$nightlight\n$powerprofile\n$theme" | rofi_cmd
}

chosen="$(run_rofi)"
case "$chosen" in
    "$apps") rofi -show drun & ;;
    "$powermenu") ~/.local/bin/power & ;;
    "$nightlight") ~/.local/bin/night-light & ;;
    "$powerprofile") auto-cpufreq-gtk & ;;
    "$theme") ~/.local/bin/theme-changer ;;
esac
