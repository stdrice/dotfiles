# // Yabai //
# Restart Yabai config
ctrl + shift - r : yabai --restart-service

# Close window
ctrl - w : yabai -m window --close

# Toggle
ctrl - e : yabai -m window --toggle split
ctrl + shift - space : yabai -m window --toggle float
ctrl - f : yabai -m window --toggle zoom-fullscreen
ctrl - p : yabai -m config focus_follows_mouse off # Disable Auto Focus
ctrl + shift - p : yabai -m config focus_follows_mouse autofocus # Enable Auto Focs

# Focus window
ctrl - h : yabai -m window --focus west || yabai -m window --focus stack.prev || yabai -m window --focus stack.last
ctrl - j : yabai -m window --focus south
ctrl - k : yabai -m window --focus north
ctrl - l : yabai -m window --focus east || yabai -m window --focus stack.next || yabai -m window --focus stack.first

# Move window
ctrl + shift - h : yabai -m window --warp west
ctrl + shift - j : yabai -m window --warp south
ctrl + shift - k : yabai -m window --warp north
ctrl + shift - l : yabai -m window --warp east

# Swap window
ctrl + shift + alt - h : yabai -m window --swap west
ctrl + shift + alt - j : yabai -m window --swap south
ctrl + shift + alt - k : yabai -m window --swap north
ctrl + shift + alt - l : yabai -m window --swap east

# Resize window
ctrl + alt - h : yabai -m window --resize left:-20:0 || yabai -m window --resize right:-20:0
ctrl + alt - l : yabai -m window --resize right:20:0 || yabai -m window --resize left:20:0
ctrl + alt - k : yabai -m window --resize top:0:-20 || yabai -m window --resize bottom:0:-20
ctrl + alt - j : yabai -m window --resize bottom:0:20 || yabai -m window --resize top:0:20

# Change workspaces
ctrl - 1 : yabai -m space --focus 1
ctrl - 2 : yabai -m space --focus 2
ctrl - 3 : yabai -m space --focus 3
ctrl - 4 : yabai -m space --focus 4
ctrl - 5 : yabai -m space --focus 5
ctrl - 6 : yabai -m space --focus 6
ctrl - 7 : yabai -m space --focus 7
ctrl - 8 : yabai -m space --focus 8
ctrl - 9 : yabai -m space --focus 9
ctrl - 0 : yabai -m space --focus 10

# Move window to workspace
ctrl + shift - 1 : yabai -m window --space 1
ctrl + shift - 2 : yabai -m window --space 2
ctrl + shift - 3 : yabai -m window --space 3
ctrl + shift - 4 : yabai -m window --space 4
ctrl + shift - 5 : yabai -m window --space 5
ctrl + shift - 6 : yabai -m window --space 6
ctrl + shift - 7 : yabai -m window --space 7
ctrl + shift - 8 : yabai -m window --space 8
ctrl + shift - 9 : yabai -m window --space 9
ctrl + shift - 0 : yabai -m window --space 10

# // Other //
# Terminal
ctrl - return : kitty --single-instance -d ~
